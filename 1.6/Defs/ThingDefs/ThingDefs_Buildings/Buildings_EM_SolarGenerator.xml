<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>EM_SolarGenerator</defName>
		<label>速建太阳能板</label>
		<description>速建太阳能板.</description>
		<thingClass>Building</thingClass>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/SolarCollector/EM_SolarCollector</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>(3,3)</drawSize>
			<shadowData>
				<volume>(1.5,0.75,1.5)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<rect>(0,0.6,2,1.8)</rect>
			</damageData>
		</graphicData>
		<!-- 是否投射边缘阴影 -->
		<castEdgeShadows>false</castEdgeShadows>
		<rotatable>false</rotatable>
		<altitudeLayer>Building</altitudeLayer>
		<!-- 通过性 -->
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<fillPercent>0.4</fillPercent>
		<!-- 是否可以重叠区域 -->
		<canOverlapZones>false</canOverlapZones>
		<statBases>
			<MaxHitPoints>800</MaxHitPoints>
			<WorkToBuild>2500</WorkToBuild>
			<Flammability>0</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<size>(2,2)</size>
		<building>
			<destroySound>BuildingDestroyed_Metal_Big</destroySound>
		</building>
		<costList>
			<Steel>200</Steel>
		</costList>
		<comps>
			<!-- 挂载反变形 Comp -->
			<li Class="EM.CompProperties_MorphBuildingToPawn">
				<!-- 反变形暖机时间 -->
				<warmupTicks>180</warmupTicks>
				<!-- 自定义 Gizmo 图标 -->
				<unmorphIconPath>UI/BuildingUnits</unmorphIconPath>
				<!-- Gizmo 按钮文本 -->
				<unmorphLabel>变回形态</unmorphLabel>
				<!-- Gizmo 描述 -->
				<unmorphDesc>变回原始 Pawn 形态。</unmorphDesc>
				<!-- 建筑被拆毁时是否掉落 Pawn (默认 true) -->
				<dropPawnIfDestroyed>true</dropPawnIfDestroyed>
			</li>
			<li Class="CompProperties_Battery">
				<storedEnergyMax>500</storedEnergyMax>
				<!-- 电池容量 -->
				<efficiency>0.8</efficiency>
				<!-- 蓄电效率 -->
				<shortCircuitInRain>false</shortCircuitInRain>
				<!-- 雨中短路 -->
				<transmitsPower>true</transmitsPower>
				<!-- 电力传输节点 -->
			</li>
			<li Class="CompProperties_Power">
				<compClass>EM.CompPowerPlantSolar</compClass>
				<!-- 基础电力消耗（负数表示产生电力） -->
				<basePowerConsumption>-2500</basePowerConsumption>
				<!-- 是否传输电力 -->
				<transmitsPower>true</transmitsPower>
			</li>
			<li Class="CompProperties_Stunnable">
				<useLargeEMPEffecter>true</useLargeEMPEffecter>
				<!-- 每刻钟受到EMP攻击的概率 -->
				<empChancePerTick>0.03</empChancePerTick>
				<!-- 影响的伤害类型 -->
				<affectedDamageDefs>
					<li>EMP</li>
				</affectedDamageDefs>
			</li>
		</comps>
		<!-- 所需地形适配度 -->
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<!-- 设计分类 -->
		<designationCategory>EM_Self-assemblyBuilding</designationCategory>
		<!-- UI排序顺序 -->
		<uiOrder>2100</uiOrder>
		<!-- 构造效果 -->
		<constructEffect>ConstructMetal</constructEffect>
		<uiIconScale>0.8</uiIconScale>
		<placeWorkers>
			<!--<li>PlaceWorker_BandNode</li>-->
		</placeWorkers>
	</ThingDef>
	
</Defs>