<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	<!-- 固定生产建设单元 -->
	<ThingDef ParentName="BuildingBase">
		<defName>EM_RecyclingMachine</defName>
		<label>回收机</label>
		<description>回收机.</description>
		<thingClass>Building</thingClass>
		<!-- 地图网格和实时渲染 -->
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/RecyclingMachine/EM_RecyclingMachine</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(5,5)</drawSize>
			<shadowData>
				<volume>(2,0.3,4.5)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<damageData>
				<rect>(0,0.6,3,2.8)</rect>
			</damageData>
		</graphicData>
		<!-- 是否投射边缘阴影 -->
		<castEdgeShadows>false</castEdgeShadows>
		<!-- 是否可以旋转 -->
		<rotatable>true</rotatable>
		<!-- 海拔层 -->
		<altitudeLayer>Building</altitudeLayer>
		<!-- 通过性 -->
		<passability>PassThroughOnly</passability>
		<!-- 移动成本 -->
		<pathCost>50</pathCost>
		<!-- 填充百分比 -->
		<fillPercent>0.3</fillPercent>
		<!-- 是否可以重叠区域 -->
		<canOverlapZones>false</canOverlapZones>
		<!-- 基础统计数据 -->
		<statBases>
			<!-- 最大生命值 -->
			<MaxHitPoints>2000</MaxHitPoints>
			<!-- 构建所需工作量 -->
			<WorkToBuild>2500</WorkToBuild>
			<!-- 易燃性 -->
			<Flammability>0</Flammability>
		</statBases>
		<!-- 计时器类型 -->
		<tickerType>Normal</tickerType>
		<!-- 大小 -->
		<size>(2,5)</size>
		<building>
			<!-- 破坏声音 -->
			<destroySound>BuildingDestroyed_Metal_Big</destroySound>
		</building>
		<!-- 成本列表 -->
		<costList>
			<Steel>200</Steel>
		</costList>
		<!-- 组件列表 -->
		<comps>
			<!-- 动力组件 -->
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>500</basePowerConsumption>
			</li>
			<!-- 可被打断组件 -->
			<li Class="CompProperties_Stunnable">
				<useLargeEMPEffecter>true</useLargeEMPEffecter>
				<!-- 每刻钟受到EMP攻击的概率 -->
				<empChancePerTick>0.03</empChancePerTick>
				<!-- 影响的伤害类型 -->
				<affectedDamageDefs>
					<li>EMP</li>
				</affectedDamageDefs>
			</li>
		</comps>
		<!-- 所需地形适配度 -->
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<!-- 设计分类 -->
		<designationCategory>EM_Self-assemblyBuilding</designationCategory>
		<!-- UI排序顺序 -->
		<uiOrder>2100</uiOrder>
		<!-- 构造效果 -->
		<constructEffect>ConstructMetal</constructEffect>
		<uiIconScale>1</uiIconScale>
	</ThingDef>
	
</Defs>